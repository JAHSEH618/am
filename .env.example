# AIWatch Docker 部署环境变量模板
# 用法：cp .env.example .env，然后填入真实值。.env 已被 .gitignore 忽略，切勿提交。

# ===== 镜像 / 分发版本（发版时只改这一处）=====
# 同步：compose image tag、Dockerfile 内 jar 版本、agent 分发包 version
AIWATCH_VERSION=1.3.3

# ===== 必改：数据库密码 =====
MYSQL_ROOT_PASSWORD=请改成强root密码
DB_USERNAME=am
DB_PASSWORD=请改成强应用密码

# ===== server 连接串 =====
# host 用 compose 服务名 mysql（容器内网），库名 am。
# 注意：characterEncoding 必须是 UTF-8（JDBC 写法，不能写 utf8mb4）；库本身才是 utf8mb4。
# 值不要加引号，& 直接写。
DB_URL=jdbc:mysql://mysql:3306/am?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true

# ===== MySQL 调优 =====
# InnoDB 缓冲池大小（默认 1G）。MySQL 自带默认只有 128MB，整窗聚合会大量读盘。按机器内存选：
#   - DB 与 server 容器同机（本 compose 的默认形态）：≈（内存 − 3G 给 server JVM − 1G 给系统）× 60~70%，最少 512M。
#       4G 机器 → 1G　　8G → 2G　　16G → 6G　　32G → 16G
#   - MySQL 独占整机时：内存的 50~60%。
# 取 1G 的整数倍（≥1G 时 MySQL 按 chunk×instances=1G 对齐，1.5G 会被向上取整成 2G）。
# 改这个值会让 compose 重建 mysql 容器 = MySQL 重启（约十几秒到一分钟，期间上报会失败、agent 自动重试），选低峰期做。
# 想不重启先在线调：docker exec -it aiwatch-mysql mysql -uroot -p -e "SET GLOBAL innodb_buffer_pool_size = 2147483648"
MYSQL_INNODB_BUFFER_POOL_SIZE=1G

# ===== server 运行参数（均可不填，用默认值）=====
# JVM OOM 堆转储（OOM 时进程会先写转储再退出，由 Docker 重启）：
#   目录默认用 compose 命名卷 heapdumps（位于 Docker data-root）。转储最大约 2GB 且含内存里的敏感数据；
#   根分区小 / 容易满的机器，请指到大盘的绝对路径（bind mount）：
# AIWATCH_HEAPDUMP_DIR=/data/aiwatch-dumps
#   开关：on（默认）/ off。on 时入口脚本还会在启动时检查转储目录所在盘的剩余空间，
#   不足下面的阈值就自动关闭并在启动日志里打 WARN（避免写转储把最后的空间吃光）：
# AIWATCH_HEAPDUMP=on
# AIWATCH_HEAPDUMP_MIN_FREE_MB=4096
# 追加 JVM 参数，排在最后（同名参数以它为准）。例：临时加堆：
# AIWATCH_JAVA_OPTS_EXTRA=-Xmx3g
# 数据库事务隔离级别。默认 TRANSACTION_REPEATABLE_READ（现状）；TRANSACTION_READ_COMMITTED 会改变事务语义，
# 切换前必读 docs/ops/read-committed-evaluation.md（需灰度 + 回归）。
# AIWATCH_DB_ISOLATION=TRANSACTION_REPEATABLE_READ
# JDBC socketTimeout（毫秒），默认 600000（10 分钟，兜网络黑洞）。0 = 不设上限：仅当本次发版含"对超大表的
# 一次性启动期 DDL 补丁"时临时使用，启动完成后改回。
# AIWATCH_DB_SOCKET_TIMEOUT_MS=600000

# ===== 离线提醒邮件 SMTP（可选；不填 HOST 则该功能不发信，不影响其他功能）=====
# 发件人地址（sys_config 的 notifications.offline_email.from）通常须 = AIWATCH_SMTP_USER，否则常被 SMTP 拒收。
# 端口：465 → SSL=true、STARTTLS=false；587 → SSL=false、STARTTLS=true。
AIWATCH_SMTP_HOST=
AIWATCH_SMTP_PORT=465
AIWATCH_SMTP_USER=
AIWATCH_SMTP_PASS=
AIWATCH_SMTP_SSL=true
AIWATCH_SMTP_STARTTLS=false
